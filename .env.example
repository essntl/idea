# ─────────────────────────────────────────────────────────────────────────────
#  Copy to .env and edit. Values marked CHANGE_ME must be changed before going
#  live — the app refuses to start while NEXTAUTH_SECRET / admin credentials
#  are missing or still placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site, without a trailing slash. Used for canonical URLs,
# sitemap, RSS, Open Graph and auth callbacks. Use https:// behind a proxy.
SITE_URL=http://localhost:3000
# Auth.js callback URL. Defaults to SITE_URL when empty.
NEXTAUTH_URL=

# Session encryption secret (32+ random characters). Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME

# Admin account, created on the first start only. Change the password later
# in Admin → Settings (changing it here has no effect once the account exists).
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD=CHANGE_ME

# ── Database ────────────────────────────────────────────────────────────────
# Used by the bundled PostgreSQL container. Use a password without @ : / ? #
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog-db-password
POSTGRES_DB=blog
# Only for running the app outside Docker (npm run dev). docker-compose.yml
# builds its own URL from the POSTGRES_* values above.
DATABASE_URL=postgresql://blog:blog-db-password@localhost:5432/blog

# ── Comments captcha ───────────────────────────────────────────────────────
# turnstile (Cloudflare, default) | recaptcha (Google reCAPTCHA v3).
# Can also be switched in Admin → Settings once both key pairs are set.
CAPTCHA_PROVIDER=turnstile
# The keys below are Cloudflare's public TEST keys: every visitor passes.
# Replace them with real keys from https://dash.cloudflare.com → Turnstile.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# From https://www.google.com/recaptcha/admin (choose "Score based (v3)").
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Uploads ─────────────────────────────────────────────────────────────────
# Where images are stored. Docker sets this to /data/uploads (a volume).
UPLOAD_DIR=./uploads
# Maximum size of a single uploaded image, in megabytes.
MAX_UPLOAD_MB=15

# ── Misc ────────────────────────────────────────────────────────────────────
# Timezone used for dates on the site (e.g. Europe/Berlin).
TZ=UTC
# Host port for the web UI (docker compose only).
APP_PORT=3000
# Set to ghcr.io/essntl/idea:latest to run the prebuilt image instead of building.
APP_IMAGE=
